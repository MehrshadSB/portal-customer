# Environment
NODE_ENV=development

# Application URLs
PORTAL_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PORT=4000
API_INTERNAL_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (port 5433 avoids collision with host Postgres on 5432)
DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5433/portal_dev
TEST_DATABASE_URL=postgresql://portal:portal_dev_password@localhost:5433/portal_test

# Redis (port 6380 avoids collision with host Redis on 6379)
REDIS_URL=redis://localhost:6380

# Authentication & Session Secrets (Replace in production)
JWT_ACCESS_SECRET=dev_only_replace_with_64_char_random_secret_for_jwt_signing_0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=false

# S3-Compatible Storage (RustFS on 9010/9011 in local development)
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=portal-attachments
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfssecret123
S3_FORCE_PATH_STYLE=true

# SMTP / Email (Mailpit in local development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Precision Ops Platform <no-reply@platform.local>"

# Swagger UI
SWAGGER_ENABLED=true
