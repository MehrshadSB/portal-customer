{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_INTERNAL_URL", "NEXT_PUBLIC_API_URL", "NEXT_OUTPUT_STANDALONE", "NEXT_TELEMETRY_DISABLED"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@portal/types#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@portal/validators#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@portal/api-client#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@portal/i18n#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@portal/ui#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "src/**", "test/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
